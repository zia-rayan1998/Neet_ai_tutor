{
  "manifest_version": 3,
  "name": "NEET AI Tutor",
  "version": "1.0.0",
  "description": "Hint-by-hint NEET solver + summarizer + mind maps",
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "NEET AI Tutor"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}